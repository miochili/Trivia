# Leave DATABASE_URL empty to run fully in-memory (built-in question bank, no stats).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trivia_quest"
PORT=3000
# Set to false to run only the Socket.io server (e.g. Next.js deployed separately)
SERVE_NEXT=true
# Comma-separated origins allowed to open sockets when running socket-only
CORS_ORIGINS=http://localhost:3000
# Frontend: where to connect. Empty = same origin as the page.
NEXT_PUBLIC_SOCKET_URL=
