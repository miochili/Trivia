{
  "name": "trivia-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime multiplayer board-game trivia: roll, move, answer, win.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src --ignore ./.next server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "start:socket-only": "SERVE_NEXT=false NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate || echo 'prisma generate skipped'",
    "build:pages": "NEXT_PUBLIC_MODE=p2p NEXT_PUBLIC_BASE_PATH=${BASE_PATH:-/trivia-quest} next build",
    "peer:local": "peerjs --port 9000 --path /"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "framer-motion": "^12.43.0",
    "mqtt": "^5.16.1",
    "next": "^16.4.6",
    "peerjs": "^1.5.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aedes": "^1.2.0",
    "peer": "^1.0.2",
    "playwright-core": "^1.65.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
